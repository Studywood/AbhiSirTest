e sun, moon and earth is","qImg":null,"exp":"","expImg":null,"tol":0,"opts":[{"t":"Sun is between earth and moon","img":null},{"t":"The earth is in between the Sun and the Moon","img":null},{"t":"Moon is between sun and earth","img":null},{"t":"Sun moon earth doesn't exist..","img":null}],"ans":2,"id":"mv43u113e0hf"},{"test":"mv4350bp6ct1","n":1791740206280,"type":"mcq","topic":"","q":"1 quintal = ____ kg","qImg":null,"exp":"","expImg":null,"tol":0,"opts":[{"t":"100 kg","img":null},{"t":"1 kg","img":null},{"t":"1000kg","img":null},{"t":"0.1 kg","img":null}],"ans":0,"id":"mv43uv9l1uw6"},{"test":"mv4350bp6ct1","n":1791740317439,"type":"mcq","topic":"","q":"SI unit of force is","qImg":null,"exp":"","expImg":null,"tol":0,"opts":[{"t":"Force","img":null},{"t":"Newton","img":null},{"t":"Kilogram","img":null},{"t":"Kg/m","img":null}],"ans":1,"id":"mv43x91blwlm"},{"test":"mv4350bp6ct1","n":1791740348577,"type":"mcq","topic":"","q":"Kg is unit of","qImg":null,"exp":"","expImg":null,"tol":0,"opts":[{"t":"Force","img":null},{"t":"distance","img":null},{"t":"Weight","img":null},{"t":"mass","img":null}],"ans":3,"id":"mv43xx2979k4"}],"papers":[],"settings":[{"id":"main","notices":[],"name":"","tag":"","wa":"9748817867","logo":null}]}